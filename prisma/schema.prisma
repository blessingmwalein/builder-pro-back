  prNumber       String
  status         PurchaseRequestStatus @default(DRAFT)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  company        Company               @relation(fields: [companyId], references: [id])
  project        Project?              @relation(fields: [projectId], references: [id])
  requestedBy    User                  @relation("PRRequester", fields: [requestedById], references: [id])
  approvedBy     User?                 @relation("PRApprover", fields: [approvedById], references: [id])
  items          PurchaseRequestItem[]
  orders         PurchaseOrder[]

  @@unique([companyId, prNumber])
  @@index([companyId, status, deletedAt])
}

model PurchaseRequestItem {
  id                String           @id @default(cuid())
  purchaseRequestId String
  materialId        String?
  description       String
  quantity          Decimal          @db.Decimal(14, 3)
  unit              String
  estimatedUnitCost Decimal?         @db.Decimal(12, 2)
  purchaseRequest   PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id])
  material          Material?        @relation(fields: [materialId], references: [id])

  @@index([purchaseRequestId])
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  companyId         String
  purchaseRequestId String?
  supplierId        String
  poNumber          String
  status            PurchaseOrderStatus @default(DRAFT)
  totalAmount       Decimal             @default(0) @db.Decimal(18, 2)
  expectedDelivery  DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  company           Company             @relation(fields: [companyId], references: [id])
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  items             PurchaseOrderItem[]
  deliveryNotes     DeliveryNote[]

  @@unique([companyId, poNumber])
  @@index([companyId, status, deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  materialId      String?
  description     String
  quantity        Decimal       @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(18, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  material        Material?     @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId])
}

model DeliveryNote {
  id              String          @id @default(cuid())
  companyId       String
  purchaseOrderId String
  deliveryDate    DateTime
  notes           String?
  receivedById    String
  createdAt       DateTime        @default(now())
  company         Company         @relation(fields: [companyId], references: [id])
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      User            @relation(fields: [receivedById], references: [id])
  items           DeliveryNoteItem[]

  @@index([companyId, purchaseOrderId])
}

model DeliveryNoteItem {
  id               String       @id @default(cuid())
  deliveryNoteId   String
  materialId       String?
  description      String
  quantityOrdered  Decimal      @db.Decimal(14, 3)
  quantityReceived Decimal      @db.Decimal(14, 3)
  deliveryNote     DeliveryNote @relation(fields: [deliveryNoteId], references: [id])
  material         Material?    @relation(fields: [materialId], references: [id])

  @@index([deliveryNoteId])
}

// ─── Approvals ───────────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  companyId       String
  entityType      String
  entityId        String
  requestedById   String
  status          ApprovalStatus @default(PENDING)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id])
  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  steps           ApprovalStep[]

  @@index([companyId, entityType, status])
  @@index([companyId, entityId])
}

model ApprovalStep {
  id                String          @id @default(cuid())
  approvalRequestId String
  stepOrder         Int
  approverId        String
  status            ApprovalStatus  @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  approver          User            @relation(fields: [approverId], references: [id])

  @@index([approvalRequestId])
  @@index([approverId, status])
}

// ─── Equipment & Inventory ───────────────────────────────────────────────────

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

model EquipmentCategory {
  id        String      @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id])
  equipment Equipment[]

  @@unique([companyId, name])
}

model Equipment {
  id           String              @id @default(cuid())
  companyId    String
  categoryId   String?
  name         String
  description  String?
  serialNumber String?
  status       EquipmentStatus     @default(AVAILABLE)
  dailyRate    Decimal?            @db.Decimal(10, 2)
  purchaseCost Decimal?            @db.Decimal(18, 2)
  purchasedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  company      Company             @relation(fields: [companyId], references: [id])
  category     EquipmentCategory?  @relation(fields: [categoryId], references: [id])
  allocations  EquipmentAllocation[]

  @@index([companyId, status, deletedAt])
}

model EquipmentAllocation {
  id            String     @id @default(cuid())
  companyId     String
  equipmentId   String
  projectId     String
  allocatedById String
  startDate     DateTime
  endDate       DateTime?
  returnedAt    DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  company       Company    @relation(fields: [companyId], references: [id])
  equipment     Equipment  @relation(fields: [equipmentId], references: [id])
  project       Project    @relation(fields: [projectId], references: [id])
  allocatedBy   User       @relation(fields: [allocatedById], references: [id])

  @@index([companyId, equipmentId])
  @@index([companyId, projectId])
}
