generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  INFRASTRUCTURE
  INDUSTRIAL
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentMethod {
  PAYNOW
  ECOCASH
  BANK_TRANSFER
  CASH
  CARD
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENT
  INVOICE_PAID
  INVOICE_OVERDUE
  BUDGET_THRESHOLD
  TIMESHEET_APPROVAL_REQUIRED
  QUOTE_SENT
  QUOTE_APPROVED
  QUOTE_REJECTED
  PROJECT_DEADLINE
  STOCK_LOW
  PROJECT_INVITE
  GENERAL
}

enum DocumentType {
  PHOTO
  PLAN
  CONTRACT
  RECEIPT
  PERMIT
  CERTIFICATE
  OTHER
}

enum MessageType {
  DIRECT
  PROJECT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  APPROVE
  REJECT
  EXPORT
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  GOVERNMENT
  OTHER
}

enum VariationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum VariationType {
  ADDITION
  OMISSION
  SUBSTITUTION
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SUBCONTRACTOR
  CASUAL
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}

enum ChangeRequestType {
  CLIENT_INITIATED
  INTERNAL
  DESIGN_CHANGE
  SCOPE_CHANGE
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Company {
  id                    String                 @id @default(cuid())
  companyId             String                 @unique
  name                  String
  slug                  String                 @unique
  subdomain             String?                @unique
  industry              String?
  address               String?
  logoUrl               String?
  logoKey               String?
  accountType           AccountType            @default(COMPANY)
  countryCode           String                 @default("ZW")
  defaultCurrency       String                 @default("USD")
  timezone              String                 @default("Africa/Harare")
  legalName             String?
  registrationNumber    String?
  taxNumber             String?
  website               String?
  companySize           String?
  yearsOperating        Int?
  teamSize              Int?
  description           String?
  businessPhone         String?
  businessEmail         String?
  city                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  users                 User[]
  roles                 Role[]
  permissions           Permission[]
  projects              Project[]
  projectMembers        ProjectMember[]
  tasks                 Task[]
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  taskChecklists        TaskChecklist[]
  taskChecklistItems    TaskChecklistItem[]
  timeEntries           TimeEntry[]
  materials             Material[]
  materialLogs          MaterialLog[]
  materialCategories    MaterialCategory[]
  materialPurchases     MaterialPurchase[]
  suppliers             Supplier[]
  quotes                Quote[]
  quoteLineItems        QuoteLineItem[]
  variations            Variation[]
  variationLineItems    VariationLineItem[]
  invoices              Invoice[]
  invoiceLineItems      InvoiceLineItem[]
  payments              Payment[]
  budgetCategories      BudgetCategory[]
  budgets               Budget[]
  financialTransactions FinancialTransaction[]
  costForecasts         CostForecast[]
  employees             Employee[]
  clients               Client[]
  conversations         Conversation[]
  messages              Message[]
  notifications         Notification[]
  documents             Document[]
  reports               Report[]
  subscriptionPlans     SubscriptionPlan[]
  subscriptions         Subscription[]
  webhooks              IntegrationWebhook[]
  auditLogs             AuditLog[]
  individualProfile     IndividualBusinessProfile?
  sectors               TenantSector[]
  projectTypes          TenantProjectType[]
  stakeholders          TenantStakeholder[]
  workflows             WorkflowTemplate[]
  settings              CompanySettings?
  projectStages         ProjectStage[]
  changeRequests        ChangeRequest[]
  clientUsers           ClientUser[]
  templates             ProjectTemplate[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  deliveryNotes         DeliveryNote[]
  approvalRequests      ApprovalRequest[]
  equipmentCategories   EquipmentCategory[]
  equipment             Equipment[]
  equipmentAllocations  EquipmentAllocation[]

  @@index([isActive, deletedAt])
}

model User {
  id                  String          @id @default(cuid())
  companyId           String
  email               String
  phone               String?
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  avatarKey           String?
  accountType         AccountType     @default(COMPANY)
  isActive            Boolean         @default(true)
  inviteToken         String?         @unique
  inviteTokenExpiresAt DateTime?
  invitedById         String?
  lastLoginAt         DateTime?
  refreshTokenHash    String?
  resetOtp            String?
  resetOtpExpiresAt   DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  company             Company         @relation(fields: [companyId], references: [id])
  userRoles           UserRole[]
  assignedTasks       TaskAssignee[]
  taskComments        TaskComment[]
  approvedTimeEntries TimeEntry[]     @relation("TimeEntryApprover")
  timeEntries         TimeEntry[]     @relation("TimeEntryWorker")
  notifications       Notification[]
  employee            Employee?
  sentMessages        Message[]       @relation("MessageSender")
  readReceipts        MessageReceipt[]
  audits              AuditLog[]      @relation("AuditActor")
  generatedReports    Report[]        @relation("ReportGenerator")
  projectMemberships  ProjectMember[]
  clientPortalLinks   ClientUser[]    @relation("ClientPortalUser")
  approvedStages      ProjectStage[]  @relation("StageApprover")
  requestedCRs        ChangeRequest[] @relation("CRRequester")
  reviewedCRs         ChangeRequest[] @relation("CRReviewer")
  approvedCRs         ChangeRequest[] @relation("CRApprover")
  requestedPRs        PurchaseRequest[] @relation("PRRequester")
  approvedPRs         PurchaseRequest[] @relation("PRApprover")
  receivedDeliveries  DeliveryNote[]
  requestedApprovals   ApprovalRequest[]    @relation("ApprovalRequester")
  approvalSteps        ApprovalStep[]
  equipmentAllocations EquipmentAllocation[]

  @@unique([companyId, email])
  @@index([companyId, isActive, deletedAt])
}

model PlatformAdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  displayName String
  apiKeyHash  String   @unique
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  company      Company           @relation(fields: [companyId], references: [id])
  userRoles    UserRole[]
  permissions  RolePermission[]
  stakeholders TenantStakeholder[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
}

model Permission {
  id          String           @id @default(cuid())
  companyId   String
  key         String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  company     Company          @relation(fields: [companyId], references: [id])
  roles       RolePermission[]

  @@unique([companyId, key])
  @@index([companyId, deletedAt])
}

model UserRole {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId, roleId])
  @@index([companyId, deletedAt])
}

model RolePermission {
  id           String     @id @default(cuid())
  companyId    String
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([companyId, roleId, permissionId])
  @@index([companyId, deletedAt])
}

model Project {
  id                 String           @id @default(cuid())
  companyId          String
  clientId           String?
  projectManagerId   String?
  code               String
  name               String
  description        String?
  projectType        ProjectType      @default(OTHER)
  siteAddress        String?
  gpsLat             Decimal?         @db.Decimal(10, 7)
  gpsLng             Decimal?         @db.Decimal(10, 7)
  templateId         String?
  priority           Priority?
  status             ProjectStatus    @default(DRAFT)
  startDate          DateTime?
  endDate            DateTime?
  actualEndDate      DateTime?
  baselineBudget     Decimal          @db.Decimal(18, 2)
  actualCost         Decimal          @default(0) @db.Decimal(18, 2)
  completionPercent  Int              @default(0)
  isArchived         Boolean          @default(false)
  // Closure metadata — set when a project is marked COMPLETED and a final
  // cost/profit snapshot is generated.
  closedAt           DateTime?
  closureSummary     Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  company            Company          @relation(fields: [companyId], references: [id])
  client             Client?          @relation(fields: [clientId], references: [id])
  tasks              Task[]
  timeEntries        TimeEntry[]
  materialLogs       MaterialLog[]
  quotes             Quote[]
  variations         Variation[]
  invoices           Invoice[]
  budgets            Budget[]
  transactions       FinancialTransaction[]
  forecasts          CostForecast[]
  conversations      Conversation[]
  documents          Document[]
  members            ProjectMember[]
  materialPurchases  MaterialPurchase[]
  stages             ProjectStage[]
  changeRequests     ChangeRequest[]
  template           ProjectTemplate?   @relation(fields: [templateId], references: [id])
  purchaseRequests   PurchaseRequest[]
  equipmentAllocations EquipmentAllocation[]

  @@unique([companyId, code])
  @@index([companyId, status, deletedAt])
}

model ProjectMember {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String
  userId      String
  role        String?
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  company     Company  @relation(fields: [companyId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([companyId, projectId, userId])
  @@index([companyId, projectId, deletedAt])
}

model Task {
  id             String            @id @default(cuid())
  companyId      String
  projectId      String
  stageId        String?
  parentTaskId   String?
  title          String
  description    String?
  status         TaskStatus        @default(TODO)
  priority       Priority          @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Decimal?          @db.Decimal(8, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  company        Company           @relation(fields: [companyId], references: [id])
  project        Project           @relation(fields: [projectId], references: [id])
  stage          ProjectStage?     @relation(fields: [stageId], references: [id])
  parentTask     Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks       Task[]            @relation("TaskHierarchy")
  assignees      TaskAssignee[]
  checklists     TaskChecklist[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  timeEntries    TimeEntry[]

  @@index([companyId, projectId, status, dueDate])
  @@index([companyId, projectId, stageId])
  @@index([companyId, deletedAt])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([companyId, taskId, userId])
  @@index([companyId, deletedAt])
}

model TaskChecklist {
  id        String              @id @default(cuid())
  companyId String
  taskId    String
  title     String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  task      Task                @relation(fields: [taskId], references: [id])
  company   Company             @relation(fields: [companyId], references: [id])
  items     TaskChecklistItem[]

  @@index([companyId, taskId, deletedAt])
}

model TaskChecklistItem {
  id          String         @id @default(cuid())
  companyId   String
  checklistId String
  content     String
  isDone      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  checklist   TaskChecklist  @relation(fields: [checklistId], references: [id])
  company     Company        @relation(fields: [companyId], references: [id])

  @@index([companyId, checklistId, deletedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, taskId, createdAt])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  companyId   String
  taskId      String
  fileKey     String
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  task        Task     @relation(fields: [taskId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, taskId, deletedAt])
}

model TimeEntry {
  id              String          @id @default(cuid())
  companyId       String
  projectId       String
  taskId          String?
  workerId        String
  approvedById    String?
  clockInAt       DateTime
  clockOutAt      DateTime?
  breakMinutes    Int             @default(0)
  gpsInLat        Decimal?        @db.Decimal(10, 7)
  gpsInLng        Decimal?        @db.Decimal(10, 7)
  gpsOutLat       Decimal?        @db.Decimal(10, 7)
  gpsOutLng       Decimal?        @db.Decimal(10, 7)
  regularHours    Decimal         @default(0) @db.Decimal(8, 2)
  overtimeHours   Decimal         @default(0) @db.Decimal(8, 2)
  hourlyRate      Decimal         @default(0) @db.Decimal(12, 2)
  labourCost      Decimal         @default(0) @db.Decimal(18, 2)
  isManualEntry   Boolean         @default(false)
  notes           String?
  status          TimeEntryStatus @default(PENDING)
  approvalComment String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  project         Project         @relation(fields: [projectId], references: [id])
  task            Task?           @relation(fields: [taskId], references: [id])
  worker          User            @relation("TimeEntryWorker", fields: [workerId], references: [id])
  approver        User?           @relation("TimeEntryApprover", fields: [approvedById], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])

  @@index([companyId, projectId, workerId, status])
  @@index([companyId, clockInAt])
}

model Supplier {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  email       String?
  phone       String?
  address     String?
  website     String?
  notes       String?
  // Comma-separated list of category codes this supplier covers
  // (kept loose to avoid a join table for now).
  categories  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  company       Company         @relation(fields: [companyId], references: [id])
  materials     Material[]
  materialLogs  MaterialLog[]
  purchases     MaterialPurchase[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
}

/**
 * Per-tenant material categories (Electrical, Plumbing, Cement, etc.).
 * Kept as a proper model so each company can curate its own list while
 * defaults are seeded idempotently by FinancialsService / MaterialsService.
 */
model MaterialCategory {
  id         String     @id @default(cuid())
  companyId  String
  code       String
  name       String
  description String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  company    Company    @relation(fields: [companyId], references: [id])
  materials  Material[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
}

/**
 * A single bulk-purchase event — one receipt from one supplier covering
 * one or more MaterialLog rows. Each line item on this purchase becomes a
 * MaterialLog (and optionally a FinancialTransaction). Receipt uploads are
 * attached here rather than on individual lines.
 */
model MaterialPurchase {
  id            String        @id @default(cuid())
  companyId     String
  supplierId    String?
  projectId     String?
  purchaseNumber String?
  purchasedAt   DateTime
  totalAmount   Decimal       @default(0) @db.Decimal(18, 2)
  notes         String?
  receiptKey    String?
  receiptUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  company       Company       @relation(fields: [companyId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  logs          MaterialLog[]

  @@index([companyId, purchasedAt])
  @@index([companyId, supplierId])
}

model Material {
  id                String        @id @default(cuid())
  companyId         String
  supplierId        String?
  categoryId        String?
  name              String
  // Legacy freeform category string — kept for back-compat; prefer categoryId.
  category          String?
  sku               String?
  unit              String
  unitCost          Decimal       @default(0) @db.Decimal(12, 2)
  stockOnHand       Decimal       @default(0) @db.Decimal(14, 3)
  reorderAt         Decimal?      @db.Decimal(14, 3)
  description       String?
  // External datasource (e.g. Electrosales) — populated when a material was
  // imported from an external catalog so repeated imports dedupe and can
  // re-sync price.
  externalSource    String?
  externalProductId String?
  externalImageUrl  String?
  externalCategory  String?
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  company           Company       @relation(fields: [companyId], references: [id])
  supplier          Supplier?     @relation(fields: [supplierId], references: [id])
  categoryRef       MaterialCategory? @relation(fields: [categoryId], references: [id])
  logs              MaterialLog[]
  quoteLineItems         QuoteLineItem[]
  purchaseRequestItems   PurchaseRequestItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  deliveryNoteItems      DeliveryNoteItem[]

  @@unique([companyId, sku])
  @@unique([companyId, externalSource, externalProductId])
  @@index([companyId, deletedAt])
  @@index([companyId, externalSource])
  @@index([companyId, categoryId])
}

model MaterialLog {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String?
  taskId      String?
  materialId  String
  supplierId  String?
  purchaseId  String?
  quantity    Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @db.Decimal(12, 2)
  totalCost   Decimal  @db.Decimal(18, 2)
  // PURCHASE = stock coming IN, USAGE = stock going OUT (default).
  entryType   String   @default("USAGE")
  usedAt      DateTime
  notes       String?
  receiptKey  String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  company     Company  @relation(fields: [companyId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  material    Material @relation(fields: [materialId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  purchase    MaterialPurchase? @relation(fields: [purchaseId], references: [id])

  @@index([companyId, projectId, usedAt])
  @@index([companyId, purchaseId])
}

model Quote {
  id             String      @id @default(cuid())
  companyId      String
  projectId      String?
  clientId       String
  quoteNumber    String
  title          String
  notes          String?
  paymentTerms   String?
  status         QuoteStatus @default(DRAFT)
  issueDate      DateTime
  expiryDate     DateTime?
  taxRate        Decimal     @default(0) @db.Decimal(5, 2)
  discountAmount Decimal     @default(0) @db.Decimal(18, 2)
  subtotal       Decimal     @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(18, 2)
  sentAt         DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNotes String?
  convertedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  company        Company     @relation(fields: [companyId], references: [id])
  project        Project?    @relation(fields: [projectId], references: [id])
  client         Client      @relation(fields: [clientId], references: [id])
  lineItems      QuoteLineItem[]
  variations     Variation[]
  invoices       Invoice[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status, issueDate])
}

model QuoteLineItem {
  id                String    @id @default(cuid())
  companyId         String
  quoteId           String
  materialId        String?
  category          String
  description       String
  quantity          Decimal   @db.Decimal(14, 3)
  unit              String?
  unitPrice         Decimal   @db.Decimal(12, 2)
  totalPrice        Decimal   @db.Decimal(18, 2)
  sortOrder         Int       @default(0)
  // External datasource snapshot (e.g. Electrosales) captured when the line
  // item was picked from an external catalog. Used to (re-)import / sync
  // Material on approval or on-demand.
  externalSource    String?
  externalProductId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  quote             Quote     @relation(fields: [quoteId], references: [id])
  company           Company   @relation(fields: [companyId], references: [id])
  material          Material? @relation(fields: [materialId], references: [id])

  @@index([companyId, quoteId, deletedAt])
  @@index([companyId, materialId])
}

model Variation {
  id             String          @id @default(cuid())
  companyId      String
  projectId      String
  quoteId        String?
  variationNumber String
  title          String
  description    String?
  type           VariationType   @default(ADDITION)
  status         VariationStatus @default(DRAFT)
  subtotal       Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal         @default(0) @db.Decimal(18, 2)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNotes String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  company        Company         @relation(fields: [companyId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id])
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  lineItems      VariationLineItem[]

  @@unique([companyId, variationNumber])
  @@index([companyId, projectId, status])
}

model VariationLineItem {
  id          String    @id @default(cuid())
  companyId   String
  variationId String
  category    String
  description String
