enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

// Promo / voucher codes — created in platform admin, redeemed at subscription activation.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String?
  discountType   PromoDiscountType @default(PERCENTAGE)
